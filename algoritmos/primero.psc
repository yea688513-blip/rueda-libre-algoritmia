Algoritmo cotizacion
	Definir nombre Como Caracter 
	Definir horas Como Entero
	Definir precioh Como Entero
	
	Escribir "hola como estas?, cual es tu nombre?"
	leer nombre
	
	Escribir "cuantas horas estuviste?"
	leer horas
	
	precioh<-10000
	
	escribir "Hola, ",nombre," tu alquiler de ",horas," horas cuesta $",(horas*precioh)
FinAlgoritmo

	
