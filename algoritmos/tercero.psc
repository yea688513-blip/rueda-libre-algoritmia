Algoritmo sin_titulo
	
	Escribir "Ingresa por favor cuantas biciletas se requieren, numero de horas, precio de recorrido por persona, numero de personas";
	leer nBici, numeroH, precioP, numeroP;
	
	totalA<-nBici*numeroH;
	totalR <- precioP*numeroP;
	totalS<-totalA+totalR;
	aporte<-(0.1*totalS);
	
	
	
	
FinAlgoritmo
